# NEAR AI Cloud API key - get from https://cloud.near.ai
NEAR_AI_API_KEY=your_key_here

# Optional: override base URL (default: https://cloud-api.near.ai/v1)
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Optional: override default TEE model
# NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# Feature flags
# VOUCH_PAID_CHECKS=false
