# NEAR AI Cloud API key — get from https://cloud.near.ai
NEAR_AI_API_KEY=your_key_here

# Optional: override base URL (default: https://cloud-api.near.ai/v1)
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Optional: override default TEE model
# NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Local SQLite path (dev/test only — not used when KV_REST_API_URL is set)
# VOUCH_DB_PATH=vouch.db

# Vercel KV (set automatically when you create a KV store in the Vercel dashboard)
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...

# Set to your production URL (auto-detected on Vercel via VERCEL_URL if not set)
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
