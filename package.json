{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app/ lib/ scripts/ tests/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "spike": "tsx -r dotenv/config scripts/spike.ts",
    "claim": "tsx -r dotenv/config scripts/claim.ts"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "lenis": "^1.3.27",
    "next": "^15.0.4",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.5"
  }
}
